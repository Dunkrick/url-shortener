APP_BASE_URL=http://localhost:8080

# Database Configuration
# Option A: Single Connection String (Neon / Cloud PostgreSQL)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Option B: Individual Variables (Docker / Local Development)
DB_HOST=localhost
DB_PORT=5433
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=url_shortener

# Redis Configuration (Optional - server falls back gracefully to DB-only if omitted)
# Option A: Redis URL with TLS and Auth (Upstash / Cloud Redis)
# REDIS_URL=rediss://default:password@host:6379
# Option B: Redis Host/Port (Docker / Local Development)
REDIS_ADDR=localhost:6379
